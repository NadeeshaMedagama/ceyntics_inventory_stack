# ============================================================
# Ceyntics Inventory Stack — Root .gitignore
# ============================================================
# Monorepo-wide ignores for the full microservices stack.
# Each sub-project (frontend/, services/*/) has its own
# .gitignore for project-specific patterns.
# ============================================================

# ─────────────────────────────────────────────
# Dependencies
# ─────────────────────────────────────────────
node_modules/
vendor/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─────────────────────────────────────────────
# Environment & Secrets
# ─────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.testing

# ─────────────────────────────────────────────
# IDE & Editor
# ─────────────────────────────────────────────
.idea/
.vscode/
.fleet/
.nova/
.zed/
*.swp
*.swo
*~
.editorconfig

# ─────────────────────────────────────────────
# OS Files
# ─────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
ehthumbs_vista.db

# ─────────────────────────────────────────────
# Next.js (Frontend)
# ─────────────────────────────────────────────
frontend/.next/
frontend/out/
frontend/build/
frontend/.vercel
frontend/.env.local

# ─────────────────────────────────────────────
# Laravel (Backend Services)
# ─────────────────────────────────────────────
services/**/storage/*.key
services/**/storage/pail
services/**/storage/logs/*.log
services/**/storage/framework/cache/data/*
services/**/storage/framework/sessions/*
services/**/storage/framework/testing/*
services/**/storage/framework/views/*.php
services/**/public/build
services/**/public/hot
services/**/public/storage
services/**/auth.json
services/**/.phpunit.result.cache
services/**/.phpunit.cache
services/**/.phpactor.json
Homestead.json
Homestead.yaml

# ─────────────────────────────────────────────
# PHP
# ─────────────────────────────────────────────
.php_cs.cache
.php-cs-fixer.cache

# ─────────────────────────────────────────────
# Testing & Coverage
# ─────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov
.phpunit.result.cache
.phpunit.cache/

# ─────────────────────────────────────────────
# Logs & Debug
# ─────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─────────────────────────────────────────────
# Docker
# ─────────────────────────────────────────────
docker-compose.override.yml

# ─────────────────────────────────────────────
# Build Artifacts
# ─────────────────────────────────────────────
dist/
*.tsbuildinfo
next-env.d.ts
*.pem

# ─────────────────────────────────────────────
# Package Managers — Lock Files
# (Keep lock files tracked for reproducible builds)
# ─────────────────────────────────────────────
# package-lock.json  ← TRACKED (needed for npm ci)
# composer.lock      ← TRACKED (needed for composer install)



# Monorepo generated dependencies/build outputs
**/node_modules/
**/vendor/
**/.next/
**/out/
**/dist/
**/build/
**/coverage/
